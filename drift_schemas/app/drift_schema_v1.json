  "fixed_sql": [
    {
      "name": "gardens",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"gardens\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "zones",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"zones\" (\"id\" TEXT NOT NULL, \"garden_id\" TEXT NOT NULL REFERENCES gardens (id), \"name\" TEXT NOT NULL, \"type\" TEXT NOT NULL DEFAULT 'other', \"archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"archived\" IN (0, 1)), \"sort_order\" INTEGER NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "activities",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"activities\" (\"id\" TEXT NOT NULL, \"garden_id\" TEXT NOT NULL REFERENCES gardens (id), \"zone_id\" TEXT NOT NULL REFERENCES zones (id), \"type\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"occurred_at\" TEXT NOT NULL, \"occurred_tz\" TEXT NOT NULL, \"notes\" TEXT NULL, \"harvest_qty\" REAL NULL, \"harvest_unit\" TEXT NULL, \"cost_czk\" REAL NULL, \"task_id\" TEXT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "photos",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"photos\" (\"id\" TEXT NOT NULL, \"garden_id\" TEXT NOT NULL REFERENCES gardens (id), \"activity_id\" TEXT NULL REFERENCES activities (id), \"local_path\" TEXT NOT NULL, \"position\" INTEGER NOT NULL DEFAULT 0, \"created_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "tasks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tasks\" (\"id\" TEXT NOT NULL, \"garden_id\" TEXT NOT NULL REFERENCES gardens (id), \"title\" TEXT NOT NULL, \"zone_id\" TEXT NULL REFERENCES zones (id), \"due\" TEXT NOT NULL, \"remind_at\" INTEGER NULL, \"rrule\" TEXT NULL, \"snoozed_until\" TEXT NULL, \"status\" TEXT NOT NULL DEFAULT 'open', \"notes\" TEXT NULL, \"completed_at\" TEXT NULL, \"completed_activity_id\" TEXT NULL, \"source\" TEXT NOT NULL DEFAULT 'user', \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "app_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    }
  ]
