-- Fronta změn k odeslání na server (synchronizace 1.0, DECLOG D69).
--
-- Triggery zapíšou do fronty každý vložený, změněný nebo smazaný řádek
-- synchronizované tabulky (natvrdo maže jen obnova ze zálohy; na server
-- se takový řádek pošle jako měkce smazaný). Řádek je ve frontě nejvýš
-- jednou; nová změna ho smaže a vloží znovu s novým pořadím, takže změna
-- během odesílání se neztratí. (INSERT OR REPLACE by v triggeru přebila
-- konfliktní strategie vnějšího příkazu.) Při zápisu dat stažených ze
-- serveru je v sync_state řádek 'applying' a triggery mlčí (žádná ozvěna
-- zpět na server).

import 'app_database.dart';

CREATE TABLE sync_outbox (
  seq INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  entity TEXT NOT NULL,
  row_key TEXT NOT NULL,
  UNIQUE (entity, row_key)
) AS SyncOutboxRow;

-- Stav synchronizace: časová razítka posledního stažení po tabulkách
-- ('pulled:<tabulka>'), zahrada spárovaná s účtem a příznak 'applying'.
CREATE TABLE sync_state (
  name TEXT NOT NULL PRIMARY KEY,
  value TEXT
) AS SyncStateRow;


CREATE TRIGGER gardens_outbox_insert AFTER INSERT ON gardens
  WHEN NOT EXISTS (SELECT 1 FROM sync_state WHERE name = 'applying')
BEGIN
  DELETE FROM sync_outbox WHERE entity = 'gardens' AND row_key = NEW.id;
  INSERT INTO sync_outbox (entity, row_key) VALUES ('gardens', NEW.id);
END;

CREATE TRIGGER gardens_outbox_update AFTER UPDATE ON gardens
  WHEN NOT EXISTS (SELECT 1 FROM sync_state WHERE name = 'applying')
BEGIN
  DELETE FROM sync_outbox WHERE entity = 'gardens' AND row_key = NEW.id;
  INSERT INTO sync_outbox (entity, row_key) VALUES ('gardens', NEW.id);
END;

CREATE TRIGGER gardens_outbox_delete AFTER DELETE ON gardens
  WHEN NOT EXISTS (SELECT 1 FROM sync_state WHERE name = 'applying')
BEGIN
  DELETE FROM sync_outbox WHERE entity = 'gardens' AND row_key = OLD.id;
  INSERT INTO sync_outbox (entity, row_key) VALUES ('gardens', OLD.id);
END;

